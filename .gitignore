# Python (backend/)
backend/.venv/
**/__pycache__/
*.pyc

# Downloadable model dependencies -- fetched via documented curl commands /
# huggingface-hub cache, not committed source (see CLAUDE.md, face_gate.py)
backend/models/

# Data directories -- regenerated by scripts/fetch_*.py, not code (see CLAUDE.md).
# Exception: backend/data/feedback/feedback.db is live user feedback history,
# NOT regenerable -- don't delete it when clearing this tree to rebuild eval/
# or clip_train/ (see app/feedback_store.py, CLAUDE.md).
backend/data/

# Stage-1 intermediate teacher checkpoint for the LoRA+MAC self-distillation
# pipeline (scripts/train_dinov3_lora_mac_stage2.py) -- training-internal,
# never read by registry.py, regenerable via
# scripts/train_dinov3_lora_mac_stage1.py (see CLAUDE.md)
backend/app/detectors/dinov3_lora_mac_stage1.safetensors
backend/app/detectors/dinov3_lora_mac_stage1_meta.json

# Node / Next.js (frontend/)
frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# Env files (frontend/.env.local has no secrets currently, but keep the
# usual Next.js convention of not committing env files)
frontend/.env*

# Claude Code local session state
.claude/

# OS
.DS_Store
